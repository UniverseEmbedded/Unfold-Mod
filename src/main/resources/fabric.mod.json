{
	"schemaVersion": 1,
	"id": "unfold",
	"version": "${version}",
	"name": "Unfold Mod",
	"description": "在MC中实现了类似纪念碑谷和FEZ的视错觉瞬移效果",
	"authors": [
		"pama1234"
	],
	"contact": {
		"homepage": "https://space.bilibili.com/646050693",
		"sources": "https://github.com/UniverseEmbedded/Unfold-Mod"
	},
	"license": "All rights reserved",
	"icon": "assets/unfold/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pama1234.unfold.UnfoldMod"
		],
		"client": [
			"pama1234.unfold.UnfoldModClient"
		]
	},
